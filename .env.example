# SOC-Playground environment. Copy to .env for local dev. In Azure, secrets
# resolve from Key Vault / Container App secrets via app/secrets.py (env wins).

# ── Local development ────────────────────────────────────────────────
# Skip the password gate with a synthetic session. NEVER set in Azure.
DEV_AUTH_BYPASS=1

# ── Auth / session (secrets) ─────────────────────────────────────────
# Required in prod. In dev, DEV_AUTH_BYPASS=1 skips the password check.
APP_PASSWORD=
# Random hex; generated at boot if unset (sessions reset on restart).
SESSION_SECRET=

# ── Model storage ────────────────────────────────────────────────────
# Local compose sets these to /models (the named volume). In Azure this is the
# Azure Files mount. HF cache lives under it so it persists too.
MODELS_DIR=/models
HF_HOME=/models/.hf_cache

# ── Download / inference guardrails ──────────────────────────────────
# Allow pickle-format weights (*.bin/*.pt). OFF by default — pickles can execute
# code on load. Only turn on for a model with no safetensors that you trust.
# ALLOW_PICKLE=1
# Allow custom modeling code (trust_remote_code). OFF by default (code exec).
# TRUST_REMOTE_CODE=1
# Max total snapshot size in bytes (default 8 GiB).
# MAX_MODEL_BYTES=8589934592
# Max generated tokens per turn.
MAX_NEW_TOKENS=512
# Advisory: warn in the UI above this many billion params (CPU RAM ceiling).
RAM_WARN_PARAM_BILLIONS=1.5

# ── Phase 2: agent tool loop ─────────────────────────────────────────
# Fail-closed killswitch for live tools. Off => tasks with tools do plain chat.
TOOLS_ENABLED=1
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=300
AGENT_STEP_MAX_NEW_TOKENS=400

# ── CrowdStrike Falcon (read-only). Leave blank to disable Falcon tools. ──
# BASE_URL is non-secret env; CLIENT_ID/SECRET resolve via app/secrets.py.
CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=

# ── Microsoft Sentinel (read-only KQL). Blank => Sentinel tools disabled. ──
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_WORKSPACE_ID=

# ── Threat intel (IOC reputation). Fail-open: blank => verdict "unknown". ──
VT_API_KEY=
ABUSEIPDB_API_KEY=

# ── Jira (read-only alert lookup). Blank => Jira tools disabled. ──
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Azure Key Vault (prod only) ──────────────────────────────────────
# AZURE_KEYVAULT_URL=https://kv-socplayground.vault.azure.net
